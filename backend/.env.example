# Copy to backend/.env and set AIB_AI_API_KEY.
# Every other setting, with its default, is in src/flow44/config.py.

# ============================================================
#  Required
# ============================================================

# Postgres, matches docker-compose
AIB_DB_NAME=buildapp
AIB_DB_USER=postgres
AIB_DB_PASSWORD=postgres
AIB_DB_HOST=localhost
AIB_DB_PORT=5432

# MinIO, matches docker-compose
AIB_S3_ENDPOINT_URL=http://127.0.0.1:9000
AIB_S3_ACCESS_KEY=minioadmin
AIB_S3_SECRET_KEY=minioadminpassword
AIB_S3_BUCKET_NAME=buildapp
# MinIO rejects the default STANDARD_IA
AIB_S3_STORAGE_CLASS=STANDARD

# AI model via OpenRouter
# Keep the openrouter/ prefix, or LiteLLM sends the request to DeepSeek directly
AIB_AI_MODEL=openrouter/deepseek/deepseek-v4.1-flash
AIB_AI_BASE_URL=https://openrouter.ai/api/v1
AIB_AI_API_KEY=sk-or-v1-...

# Verifies login tokens, pairs with the private key in mocks/flapi-mock/server.ts
AIB_AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA5rlPsrOc6JVYs6jqDizj
xDOqisNTts7yw66deyze9Hz3CC5aixvPrnAiRvOU75cR6PQYzXtPMCsZflfmILgJ
BfPAlRc7yF211JBY6u9Iq6K3JN7cNyhH79GW6dDMZyqINXMea84eQmBwbQKHgqwF
QF+hBtIGfVKAapRiBbQAEcYFFVFjQ2rH4cyAiPLwHotKHP+Aa9/9E1Le3m60pNFA
Z1iJ/7ovLm1o0ENTQKbFEyzXbupet2fzkUn8jauPVDOpWxFxsEI47dVlb5JZULnu
szX30m3EQD5lDjbNDMUVmo23eriQjDhamhr7Rbh26N8Di6WkZv6GnzsbpPmdprp2
TwIDAQAB
-----END PUBLIC KEY-----"


# ============================================================
#  Optional
# ============================================================

# Admin access for the mock SSO user
# AIB_SYSTEM_ADMIN_IDS=["dev-user"]

# Other AI providers

# vLLM
# AIB_AI_MODEL=qwen/qwen3-coder-30b-a3b-instruct
# AIB_AI_BASE_URL=http://flow-44-models.com/openai/v1
# AIB_AI_API_KEY=default

# Ollama
# AIB_AI_MODEL=qwen3:30b
# AIB_AI_BASE_URL=http://localhost:11434/v1
# AIB_AI_API_KEY=default

# Anthropic, uses ANTHROPIC_API_KEY
# AIB_AI_MODEL=anthropic/claude-sonnet-4-5-20250514

# AWS Bedrock, ignores AIB_AI_BASE_URL
# AIB_AI_MODEL=bedrock/us.anthropic.claude-sonnet-4-6

# AI timeouts in seconds: plan/followup calls, then streaming codegen/fix calls
# AIB_AI_REQUEST_TIMEOUT=300
# AIB_AI_STREAM_TIMEOUT=600

# Turn off for providers that reject prompt_cache_key
# AIB_AI_SEND_PROMPT_CACHE_KEY=true

# Opik tracing, on when the key is set
# AIB_OPIK_API_KEY=...
# AIB_OPIK_WORKSPACE=your-workspace
# AIB_OPIK_PROJECT_NAME=buildapp
# AIB_OPIK_URL_OVERRIDE=http://localhost:5173/api

# Also write JSON logs to a file
# AIB_LOG_FILE_PATH=app.log


# ============================================================
#  Docker build args, read by the Dockerfiles, not the backend
# ============================================================

# Backend image and uv.toml (App.Dockerfile)
BACKEND_BASE_IMAGE=python:3.12-slim
UV_INDEX_URL=https://pypi.org/simple
UV_NATIVE_TLS=true
UV_INDEX_NAME=default
UV_INDEX_DEFAULT=true
UV_INSECURE_HOST1=
UV_INSECURE_HOST2=

# Frontend images (frontend/Dockerfile)
FRONTEND_BASE_IMAGE=node:24-slim
NGINX_IMAGE=nginx:alpine

# Backend address used by nginx.conf
BACKEND_INTERNAL_URL=http://base-backend.base:8000
