# Test Environment Configuration
# Tests attach to the running Postgres (docker-compose in dev, service container in CI)
# and create an isolated per-worker database via DatabaseJanitor (see conftest.py).
# AIB_DB_NAME is a placeholder; conftest overrides it with the per-worker db.
AIB_DB_NAME=test
AIB_DB_USER=postgres
AIB_DB_PASSWORD=postgres
AIB_DB_HOST=localhost
AIB_DB_PORT=5432
AIB_MAX_COMMAND_TIMEOUT=30
# Dummy secret — every test patches flow44.api.deps.settings, so this value
# only needs to satisfy the required-field check at import time.
AIB_AUTH_JWT_PUBLIC_KEY=test-public-key-not-used

# Dummy S3 config — individual tests patch flow44.config.settings as needed,
# these only need to satisfy the required-field check at import time.
AIB_S3_ENDPOINT_URL=http://localhost:9000
AIB_S3_ACCESS_KEY=test-access-key
AIB_S3_SECRET_KEY=test-secret-key
AIB_S3_BUCKET_NAME=test-bucket
