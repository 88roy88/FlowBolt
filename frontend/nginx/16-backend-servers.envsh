#!/bin/sh
# Builds the backend upstream's `server` lines (BACKEND_SERVERS) for default.conf.template. Set:
#   BACKEND_INTERNAL_URL
# or, for multiple pods (w/ stickiness):
#   BACKEND_STATEFULSET, BACKEND_SERVICE, BACKEND_REPLICAS (+ optional BACKEND_PORT, default 8000)
# Details: docs/multi-pod.md.

_fail() {
    echo "16-backend-servers: $1" >&2
    exit 1
}

if [ -n "${BACKEND_STATEFULSET:-}${BACKEND_REPLICAS:-}" ]; then
    [ -n "${BACKEND_INTERNAL_URL:-}" ] && _fail "set BACKEND_INTERNAL_URL or BACKEND_STATEFULSET/REPLICAS, not both"
    [ -n "${BACKEND_STATEFULSET:-}" ] && [ -n "${BACKEND_REPLICAS:-}" ] \
        || _fail "set both BACKEND_STATEFULSET and BACKEND_REPLICAS"
    BACKEND_SERVERS=""
    _i=0
    while [ "$_i" -lt "$BACKEND_REPLICAS" ]; do
        _host="${BACKEND_STATEFULSET}-${_i}${BACKEND_SERVICE:+.$BACKEND_SERVICE}"
        BACKEND_SERVERS="${BACKEND_SERVERS}server ${_host}:${BACKEND_PORT:-8000} resolve; "
        _i=$((_i + 1))
    done
elif [ -n "${BACKEND_INTERNAL_URL:-}" ]; then
    # http://host:port/path -> host:port
    _host="${BACKEND_INTERNAL_URL#*://}"
    BACKEND_SERVERS="server ${_host%%/*}; "
else
    _fail "set BACKEND_INTERNAL_URL (one backend pod) or BACKEND_STATEFULSET, BACKEND_SERVICE and BACKEND_REPLICAS"
fi
export BACKEND_SERVERS

echo "16-backend-servers: $BACKEND_SERVERS"
unset -f _fail
unset _i _host
