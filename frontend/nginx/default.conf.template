# Map for webSocket connection upgrades
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $uri $frame_options {
    default "SAMEORIGIN";
    ~^/shared/ "";
    ~^/preview/ "";
}

# Keep each project on one backend pod (docs/multi-pod.md).
map $uri $project_key {
    ~^/(?:api|ws)/projects/(?<project>[^/]+)  $project;
    ~^/(?:api/)?preview/(?<project>[^/]+)     $project;
    default                                   $request_id;
}

# Re-resolve the backend pod names every 5s, since a restarted pod gets a new IP.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

upstream backend {
    zone backend 64k;
    hash $project_key consistent;
    ${BACKEND_SERVERS}
}

server {
    listen 8080;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json ;

    # Security headers
    add_header X-Frame-Options $frame_options always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Upstream servers are StatefulSet pods and don't skip dead pods automatically: fail fast to move to next pod.
    proxy_connect_timeout 3s;

    # SPA — proxy to frontend container
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # API proxy
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # For >1MB file uploads
        client_max_body_size 5M;

        # Timeout for long-running operations (model loading, processing)
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 32k;

        # Retry on another pod only if this one is unreachable: retrying an error response would start
        # a second sandbox for the project on a different pod.
        proxy_next_upstream error timeout;
    }

    # WebSocket proxy
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Public share route — serves published apps by custom slug
    location /shared/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Preview proxy — routes through backend which reverse-proxies to sandbox port
    location ~ ^/preview/(?<session_id>[a-zA-Z0-9_-]+)(?<preview_path>/.*)$ {
        proxy_pass http://backend/api/preview/$session_id/proxy$preview_path$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
